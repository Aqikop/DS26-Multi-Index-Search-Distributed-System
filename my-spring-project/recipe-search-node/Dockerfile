FROM maven:3.9.4-eclipse-temurin-17 AS build
WORKDIR /app
COPY pom.xml .
COPY shared-models shared-models
COPY recipe-search-node recipe-search-node
RUN mvn -pl shared-models,recipe-search-node clean install -DskipTests

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /app/recipe-search-node/target/recipe-search-node-*.jar app.jar
EXPOSE 8100
ENTRYPOINT ["java", "-jar", "app.jar"]
